# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ---- Node ----
node_modules/

# ---- pip 被中断时留在当前目录的解包残留 ----
# （pip 22.x 在解析阶段被 Ctrl+C 或 kill 会留下 pip-unpack-* 临时目录）
pip-unpack-*

# ---- 渲染输出目录：只是看一眼用的转储，不是构建依赖 ----
presentation/deck-preview/
presentation/style-preview/
presentation/frontend-mockup-render/

# ---- 单张预览转储（正式交付物是 .pptx，不需要这些 PNG）----
# 注意通配符要写精确：不能用 *预览.png，会误伤下面的构建素材
presentation/银行AI智能体全流程规划-*预览.png

# ---- 过程稿：已被正式主文件取代，不留（含其预览图）----
presentation/*风格样稿*
presentation/*前端工作台预览*.pptx

# ⚠️ 不要忽略以下文件，它们是构建依赖，不是转储：
#   presentation/银行Agent前端工作台预览.png  ← build_bank_agent_deck.js 第 3 页 addImage 直接读取
#   presentation/有度-银行AI智能体全流程规划.pptx  ← 交付物成品
#   presentation/assets/**                    ← 流程图源与导出

# ---- 本地配置与密钥 ----
.env
.env.*
!.env.example

# ---- 外部工具目录（不随项目走）----
_mermaid-tools/
