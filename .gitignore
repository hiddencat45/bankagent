# ---- Node ----
node_modules/

# ---- pip 被中断时留在当前目录的解包残留 ----
# （pip 22.x 在解析阶段被 Ctrl+C 或 kill 会留下 pip-unpack-* 临时目录）
pip-unpack-*

# ---- 渲染输出目录：只是看一眼用的转储，不是构建依赖 ----
presentation/deck-preview/
presentation/style-preview/
presentation/frontend-mockup-render/

# ---- 单张预览转储（正式交付物是 .pptx，不需要这些 PNG）----
# 注意通配符要写精确：不能用 *预览.png，会误伤下面的构建素材
presentation/银行AI智能体全流程规划-*预览.png

# ---- 过程稿：已被正式主文件取代，不留（含其预览图）----
presentation/*风格样稿*
presentation/*前端工作台预览*.pptx

# PPT交付物与docs/evidence中的真实窗口素材必须纳入版本控制。
# 旧教学PPT生成器及专属素材已清理，新源为presentation/build_delivery_deck.mjs。

# ---- 本地配置与密钥 ----
.env
.env.*
!.env.example

# Desktop diagnostics generated locally, never credentials or deliverables.
.desktop-tmp/
.desktop-check.log
Youdu.lnk
Youdu.exe
debug.log
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

